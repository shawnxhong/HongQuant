# Copy to .env and fill in; .env is gitignored.

# ---- Runtime ----
HONGQUANT_ENV=dev                     # dev | prod
HONGQUANT_DATA_DIR=./data             # Parquet data lake root
HONGQUANT_LOG_LEVEL=INFO

# ---- Alpaca (US equities OHLCV) ----
# Free with brokerage or market-data account: https://alpaca.markets/
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true                     # true -> paper; false -> live

# ---- Interactive Brokers (options chain + live) ----
# Requires TWS or IB Gateway running locally or on VPS.
# Install the extra: `uv sync --extra ibkr` (pulls ib_async).
# For OpEx agent production use, IB Gateway live (4001) is recommended.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                        # 7497 paper TWS, 7496 live TWS, 4002 gateway paper, 4001 gateway live
IBKR_CLIENT_ID=17
IBKR_MARKET_DATA_TYPE=1               # 1 live, 2 frozen, 3 delayed, 4 delayed-frozen

# ---- SEC EDGAR ----
# EDGAR requires a User-Agent with contact info per their fair-access policy
EDGAR_USER_AGENT="HongQuant research youremail@example.com"

# ---- FRED (macro) ----
FRED_API_KEY=

# ---- Crypto exchanges (ccxt) ----
# Only keep the ones you actually use; leave blank for public market-data only
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ---- Optional paid data ----
OPTIONS_DATA_PROVIDER=yfinance          # yfinance | polygon | ibkr
POLYGON_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
TIINGO_API_KEY=

# ---- LLM providers ----
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=

# ---- Fragility radar — LLM narrative layer ----
# The radar's deterministic scores run with no LLM. The optional narrative
# layer (briefing + Bull's-Advocate vs Fragility-Hawk red-team) consumes the
# pre-computed numbers only — it never invents figures.
# Defaults to the most capable Claude model; the design favors a cheap model
# (token cost is not a concern), so set claude-haiku-4-5 to follow that intent.
FRAGILITY_ENABLE_LLM=true
FRAGILITY_LLM_PROVIDER=anthropic        # anthropic (only provider wired today)
FRAGILITY_LLM_MODEL=claude-opus-4-8     # e.g. claude-haiku-4-5 for the cheap path
ANTHROPIC_SELF_CHECK_MODEL=claude-haiku-4-5
# Note: the COT gold-positioning signal needs no key (CFTC is public).
# The market-level systemic gate (NFCI/STLFSI4) uses FRED_API_KEY above; it
# degrades to a VIX-term-structure-only gate when the key is absent.

# ---- Telegram notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email notifications (OpEx risk reports) ----
# Works with Gmail app-password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=                              # comma-separated recipients

# ---- Weekly self-check ----
# Used by `uv run python -m hongquant.diagnostics.weekly_self_check`.
SELF_CHECK_TOTAL_TIMEOUT_SECONDS=300
SELF_CHECK_SOURCE_TIMEOUT_SECONDS=30
SELF_CHECK_LLM_TIMEOUT_SECONDS=45

# ---- Postgres (elsewhere-stored metadata) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hongquant
POSTGRES_USER=hongquant
POSTGRES_PASSWORD=hongquant
